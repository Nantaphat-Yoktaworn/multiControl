[Unit]
Description=MultiControl Central Hub & Layout Studio Docker Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Update WorkingDirectory to match your local clone path (or use %h/multiControl)
WorkingDirectory=/path/to/multiControl
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
TimeoutStartSec=0

[Install]
WantedBy=default.target
