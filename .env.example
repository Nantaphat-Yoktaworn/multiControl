# MultiControl Hub Configuration
# Copy this file to .env and customize values as needed.

# Container timezone (default: UTC)
TZ=UTC

# Web UI & WebSocket Control Plane port (TCP) and UDP Relay port (UDP)
MULTICONTROL_PORT=8765
MULTICONTROL_UDP_PORT=8766

# Optional: Explicit LAN IP advertised in installer commands and client.zip.
# Leave empty to automatically infer from the browser/client request Host header.
MULTICONTROL_LAN_IP=

# Optional: Tailscale / overlay VPN IP to enable the VPN route toggle in the Web UI.
# Leave empty if not using Tailscale.
MULTICONTROL_TAILSCALE_IP=

# Optional: Fixed pairing token for agents.
# If unset, a random token is generated and persisted in data/state.json on first start.
MULTICONTROL_TOKEN=
